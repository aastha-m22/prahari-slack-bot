# Slack (create an app with Socket Mode; see README)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
ALERT_CHANNEL=#prahari-alerts

# PRAHARI backend
PRAHARI_URL=http://127.0.0.1:8000

# Optional: LLM summaries via Groq (falls back to a rule-based summary without it)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alert threshold (risk index 0-100) and webhook shared secret
ALERT_RISK_THRESHOLD=45
INGEST_SECRET=change-me
